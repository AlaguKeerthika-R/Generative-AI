#Multi Agent Agno with 3 agents

import os
from getpass import getpass
from agno.agent import Agent
from agno.team import Team
from agno.models.groq import Groq

os.environ["GROQ_API_KEY"]=getpass("Enter GROQ API Key: ")

model=Groq(id="openai/gpt-oss-20b")
#Agent 1 - Researcher
researcher=Agent(
    name="Researcher",
    role="Research the given topic",
    model=model,
    instructions=[
        "Research the topic carefully",
        "Provide important facts and information"
    ]
)

#Agent 2 - Technical Expert
technical_expert=Agent(
    name="Technical Expert",
    role="Explain technical concepts",
    model=model,
    instructions=[
        "Explain technical concepts clearly",
        "Provide simple real-world examples"
    ]
)

#Agent 3 - Summarizer
summarizer=Agent(
    name="Summarizer",
    role="Prepare a simple summary",
    model=model,
    instructions=[
        "Summarize the informtion",
        "Use simple English and bullet points"
    ]
)

#Create multi agent taem
team=Team(
    name="AI Research Team",
    model=model,
    members=[
        researcher,
        technical_expert,
        summarizer
    ],
    instructions=[
        "You must delegate tasks to all three agents.",
        "First, ask the Researcher to gather important information.",
        "Next, ask the Technical Expert to explain the topic with examples.",
        "Then, ask the Summarizer to prepare a concise summary.",
        "Finally, combine all three agents' contributions into one answer."
    ],
    markdown=True,
    show_members_responses=True 
)

#User input
question=input("Enter your question: ")

#Run the multi agent team
team.print_response(question,stream=True)
