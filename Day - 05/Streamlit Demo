#Implemented basic tags in Streamlit in VS Code

import streamlit as st 

st.title("hello")
st.header("hello")
st.subheader("hello")
st.text("hello")
st.success("hello")
st.markdown("hello")
st.code("hello")
st.info("info tag hello")
st.warning("warning hello")
st.error("error hello")

##Button Tags...
st.title("Buttons")
if st.button("click me"):
    st.success("button clicked successfully")

#Text input...
st.text_input("Enter text")

#Number input...(with restrictions)
st.number_input("Enter number", min_value=1, max_value=100, value=20)

#text area...
st.text_area("Text area")

#Select box...
course=st.selectbox(
    "select course",
    ["python","java", "hi"]
)

#radio box...
course=st.radio(
    "select course",
    ["python","java", "hi"]
)
#Multi-select...
course=st.multiselect(
    "select course",
    ["python","java", "hi"]
)
#checkbox...
agree=st.checkbox("I agree")
if agree:
    st.success("Done")
st.snow()

#sliders..
marks=st.slider(
    "select-slider marks",
    min_value=3, max_value=20
)

#store data...
students=[
    {"Name":"B","marks":56},
    {"Name":"Keerthika","marks":85}
]
st.write(students)
st.snow()
